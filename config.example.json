{
  "output_dir": "history",
  "group_by": "month",
  "poll_interval": 0.8,
  "capture_text": true,
  "capture_images": true,
  "image_format": "png",
  "image_quality": 92,
  "image_max_side": 0,
  "max_text_length": 200000,
  "ignore_patterns": [
    "^password",
    "^passwd"
  ],
  "log_enabled": true,
  "log_max_bytes": 2097152,
  "console_echo": false
}
